# Copiază în `.env` și completează local. Nu comite niciodată `.env`.

# Conexiunea PostgreSQL (local: vezi docs/RUNBOOK.md)
DATABASE_URL=postgresql://dp:dp_local_dev@localhost:5432/dp_web

# Secret lung și aleator pentru Payload (ex: `openssl rand -hex 32`)
PAYLOAD_SECRET=

# URL-ul public al site-ului, fără slash final (folosit pentru canonical, sitemap, CSRF)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mediul: `production` doar pe site-ul public. Activează indexarea (robots.txt) și ascunde paginile legale
# până sunt completate Datele legale din Setări site. Gol / `staging` / `development` = neindexat.
SITE_ENV=

# Secret pentru hash-ul IP la limitarea cererilor de contact (ex: `openssl rand -hex 32`)
CONTACT_HASH_SECRET=

# Email (opțional local). Fără SMTP_HOST, notificările rămân „în așteptare” și se pot retrimite din admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Daniel Popescu — website
# Adresa care primește notificările despre solicitări noi
CONTACT_NOTIFY_TO=

# Media: director local persistent (implicit ./media)
MEDIA_DIR=

# Analytics (opțional, dezactivat dacă e gol). Vezi docs/TOOLS.md.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# Doar pentru seed-ul local de dezvoltare (scripts/seed-dev.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
